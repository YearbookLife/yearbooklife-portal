{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "login.html",
      "use": "@vercel/static"
    },
    {
      "src": "set-password.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/hubspot-deal",
      "dest": "/api/hubspot-deal.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/supabase-config",
      "dest": "/api/supabase-config.ts",
      "methods": [
        "GET",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/find-my-deals",
      "dest": "/api/find-my-deals.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/mark-activated",
      "dest": "/api/mark-activated.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/send-invite",
      "dest": "/api/send-invite.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/cron-send-invites",
      "dest": "/api/cron-send-invites.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/cron-cleanup-stale-users",
      "dest": "/api/cron-cleanup-stale-users.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/save-progress",
      "dest": "/api/save-progress.ts",
      "methods": [
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/get-field-options",
      "dest": "/api/get-field-options.ts",
      "methods": [
        "GET"
      ]
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/set-password",
      "dest": "/set-password.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-send-invites",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron-cleanup-stale-users",
      "schedule": "0 5 * * *"
    }
  ]
}
