{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "login.html",
      "use": "@vercel/static"
    },
    {
      "src": "set-password.html",
      "use": "@vercel/static"
    },
    {
      "src": "pp.html",
      "use": "@vercel/static"
    },
        {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/hubspot-deal",
      "dest": "/api/hubspot-deal.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/supabase-config",
      "dest": "/api/supabase-config.ts",
      "methods": [
        "GET",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/find-my-deals",
      "dest": "/api/find-my-deals.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/mark-activated",
      "dest": "/api/mark-activated.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/send-invite",
      "dest": "/api/send-invite.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/cron-send-invites",
      "dest": "/api/cron-send-invites.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/cron-cleanup-stale-users",
      "dest": "/api/cron-cleanup-stale-users.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/save-progress",
      "dest": "/api/save-progress.ts",
      "methods": [
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/api/knowledge-base",
      "dest": "/api/knowledge-base.ts",
      "methods": [
        "GET",
        "OPTIONS"
      ]
    },
        {
      "src": "/api/request-new-link",
      "dest": "/api/request-new-link.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
        {
      "src": "/(.*\\.png)",
      "dest": "/$1"
        },
    {
      "src": "/api/portraitpop-pass",
      "dest": "/api/portraitpop-pass.ts",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/portraitpop-verify",
      "dest": "/api/portraitpop-verify.ts",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/api/portraitpop",
      "dest": "/api/portraitpop.ts",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/pp-auth",
      "dest": "/api/pp-auth.ts",
      "methods": ["GET", "POST"]
    },
    {
      "src": "/api/pp-photographer",
      "dest": "/api/pp-photographer.ts",
      "methods": ["GET", "POST"]
    },
    {
      "src": "/api/pp-staff",
      "dest": "/api/pp-staff.ts",
      "methods": ["GET", "POST"]
    },
    {
      "src": "/api/pp-tool",
      "dest": "/api/pp-tool.ts",
      "methods": ["GET"]
    },
    {
      "src": "/api/pp-verify",
      "dest": "/api/pp-verify.ts",
      "methods": ["POST"]
    },
    {
      "src": "/api/pp-cron",
      "dest": "/api/pp-cron.ts",
      "methods": ["GET"]
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts",
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ]
    },
    {
      "src": "/pp(/signin)?/?",
      "dest": "/pp.html"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/set-password",
      "dest": "/set-password.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-send-invites",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron-cleanup-stale-users",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/pp-cron",
      "schedule": "0 6 * * *"
    }
  ]
}
